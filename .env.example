# =============================================================================
# Handan Web — environment variables
#
#   cp .env.example .env     and fill in the values below.
#
# Only the first two are required. Everything else has a working default.
# `.env` is gitignored; never commit real secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# PostgreSQL connection string.
#
#   local Postgres    postgresql://handan:handan@localhost:5432/handan?schema=public
#   docker compose    the host is the service name `db`, not localhost:
#                     postgresql://handan:<password>@db:5432/handan?schema=public
#   Supabase / Neon   use the POOLED connection string, not the direct one.
#                     On serverless, every invocation opens its own connection and
#                     un-pooled Postgres runs out under load — it will pass testing
#                     and fail in production. Prisma migrations want the direct URL,
#                     so set DIRECT_DATABASE_URL as well in that case.
DATABASE_URL="postgresql://handan:handan@localhost:5432/handan?schema=public"

# Signs the JWT access tokens issued at login.
#
# Generate one with:   openssl rand -base64 48
#
# Use a different value per environment. Changing it invalidates every existing
# token, which logs all users out — that is also how you force a logout everywhere.
JWT_SECRET="change-me-openssl-rand-base64-48"


# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------

# Where the browser sends GraphQL requests.
#
# LEAVE EMPTY. Empty means "this app's own /api/graphql", which is the normal
# setup — the API ships inside this Next.js app.
#
# Only set it to point the frontend at a GraphQL API on a different origin (for
# example the original Elixir backend at http://localhost:4000). The value is
# inlined into the client bundle at BUILD time, so changing it needs a rebuild.
NEXT_PUBLIC_HANDAN_API=""

# Direct (non-pooled) Postgres URL, used by MIGRATIONS ONLY.
#
# Set this when DATABASE_URL points at a connection pooler (Supabase, Neon,
# PgBouncer): pooled connections cannot run schema changes reliably. The running
# app still uses the pooled DATABASE_URL. Leave unset for a plain local Postgres —
# migrations then fall back to DATABASE_URL.
# DIRECT_DATABASE_URL="postgresql://user:password@db.example.com:5432/handan"


# -----------------------------------------------------------------------------
# DOCKER COMPOSE ONLY
#
# Read by docker-compose.yml. Ignored when running with `pnpm dev`.
# Compose builds DATABASE_URL for the container from the three POSTGRES_* values,
# so set the password here rather than editing DATABASE_URL above.
# -----------------------------------------------------------------------------

POSTGRES_USER="handan"
POSTGRES_PASSWORD="change-me-too"
POSTGRES_DB="handan"

# Host port the app is published on (container always listens on 3000).
# Put a TLS reverse proxy (Caddy, nginx) in front of this in production.
APP_PORT="3000"
