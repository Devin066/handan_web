generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  uuid        String   @id @default(uuid())
  name        String
  description String?
  insertedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff Staff[]
  users User[]
}

model User {
  uuid         String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  nickname     String?
  bio          String?
  avatarUrl    String?
  role         String    @default("employee")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  companyUuid  String?
  insertedAt   DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company          Company?              @relation(fields: [companyUuid], references: [uuid])
  staff            Staff[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  assignedCards    JobCard[]             @relation("JobCardAssignedBy")
  validatedCards   JobCard[]             @relation("JobCardValidatedBy")
  inventoryEntries InventoryEntry[]
  interactions     CustomerInteraction[]
}

model Staff {
  uuid           String    @id @default(uuid())
  email          String
  name           String?
  phone          String?
  position       String?
  employmentType String    @default("regular")
  shift          String?
  hiredAt        DateTime?
  baseRate       Decimal   @default(0) @db.Decimal(18, 4)
  status         String    @default("active")
  userUuid       String?
  companyUuid    String
  insertedAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User?              @relation(fields: [userUuid], references: [uuid])
  company        Company            @relation(fields: [companyUuid], references: [uuid])
  jobCards       JobCard[]
  workstations   Workstation[]      @relation("WorkstationMembers")
  attendance     AttendanceRecord[]
  payrollEntries PayrollEntry[]

  @@index([companyUuid])
}

model Uom {
  uuid        String   @id @default(uuid())
  name        String
  symbol      String?
  category    String   @default("count")
  description String?
  companyUuid String
  insertedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockUoms StockUom[]

  @@index([companyUuid])
}

model Item {
  uuid                String   @id @default(uuid())
  name                String
  sku                 String?
  itemType            String   @default("raw_material")
  category            String?
  grade               String?
  dimensions          String?
  spec                String?
  description         String?
  sellingPrice        Decimal  @default(0) @db.Decimal(18, 4)
  standardCost        Decimal  @default(0) @db.Decimal(18, 4)
  minStockThreshold   Decimal  @default(0) @db.Decimal(18, 4)
  storageLocation     String?
  marketplaceRef      String?
  status              String   @default("active")
  defaultSupplierUuid String?
  companyUuid         String
  insertedAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt

  stockUoms          StockUom[]
  stockItems         StockItem[]
  boms               Bom[]
  bomItems           BomItem[]
  inventoryEntries   InventoryEntry[]
  salesOrderItems    SalesOrderItem[]
  deliveryNoteItems  DeliveryNoteItem[]
  purchaseOrderItems PurchaseOrderItem[]
  receiptNoteItems   ReceiptNoteItem[]
  workOrders         WorkOrder[]
  materialRequests   WorkOrderMaterialRequest[]
  defaultSupplier    Supplier?                  @relation(fields: [defaultSupplierUuid], references: [uuid])

  @@unique([companyUuid, sku])
  @@index([companyUuid])
  @@index([companyUuid, itemType])
}

model StockUom {
  uuid             String @id @default(uuid())
  itemUuid         String
  uomUuid          String
  conversionFactor Int    @default(1)
  sequence         Int    @default(0)

  item             Item                       @relation(fields: [itemUuid], references: [uuid], onDelete: Cascade)
  uom              Uom                        @relation(fields: [uomUuid], references: [uuid])
  stockItems       StockItem[]
  inventoryEntries InventoryEntry[]
  bomItems         BomItem[]
  materialRequests WorkOrderMaterialRequest[]

  @@index([itemUuid])
}

model Warehouse {
  uuid         String   @id @default(uuid())
  name         String
  address      String?
  area         String?
  contactName  String?
  contactEmail String?
  isDefault    Boolean  @default(false)
  companyUuid  String
  insertedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockItems       StockItem[]
  inventoryEntries InventoryEntry[]
  salesOrders      SalesOrder[]
  purchaseOrders   PurchaseOrder[]
  deliveryNotes    DeliveryNote[]
  receiptNotes     ReceiptNote[]
  workOrders       WorkOrder[]
  materialRequests WorkOrderMaterialRequest[]

  @@index([companyUuid])
}

model StockItem {
  uuid            String   @id @default(uuid())
  itemUuid        String
  warehouseUuid   String
  stockUomUuid    String
  totalOnHand     Decimal  @default(0) @db.Decimal(18, 4)
  reservedQty     Decimal  @default(0) @db.Decimal(18, 4)
  inProductionQty Decimal  @default(0) @db.Decimal(18, 4)
  companyUuid     String
  insertedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  item      Item      @relation(fields: [itemUuid], references: [uuid], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseUuid], references: [uuid])
  stockUom  StockUom  @relation(fields: [stockUomUuid], references: [uuid])

  @@unique([itemUuid, warehouseUuid, stockUomUuid])
  @@index([companyUuid])
}

model InventoryEntry {
  uuid                 String   @id @default(uuid())
  code                 String
  type                 String
  actualQty            Decimal  @db.Decimal(18, 4)
  qtyBeforeTransaction Decimal  @default(0) @db.Decimal(18, 4)
  qtyAfterTransaction  Decimal  @db.Decimal(18, 4)
  reason               String?
  createdByUserUuid    String?
  threadType           String?
  threadUuid           String?
  itemUuid             String
  warehouseUuid        String
  stockUomUuid         String
  companyUuid          String
  insertedAt           DateTime @default(now())
  updatedAt            DateTime @updatedAt

  item      Item      @relation(fields: [itemUuid], references: [uuid])
  warehouse Warehouse @relation(fields: [warehouseUuid], references: [uuid])
  stockUom  StockUom  @relation(fields: [stockUomUuid], references: [uuid])
  createdBy User?     @relation(fields: [createdByUserUuid], references: [uuid])

  @@index([companyUuid])
  @@index([itemUuid])
}

model Customer {
  uuid String @id @default(uuid())

  /**
   * Display name, shown on every order, invoice and delivery note and copied
   * onto those documents when they are created. Derived server-side from the
   * name parts below (or companyName for a business), so it is never edited
   * directly and can never disagree with them.
   */
  name String

  customerType String @default("individual")

  // Philippine personal names carry a middle name (conventionally the mother's
  // maiden surname) and very often a suffix, and both appear on official
  // documents — so they are separate fields rather than one free-text name.
  firstName   String?
  middleName  String?
  lastName    String?
  suffix      String?
  companyName String?
  /**
   * Person to talk to at a business customer.
   */
  contactName String?

  // Contact numbers. Mobile is the one that matters: many customers have no
  // landline at all.
  phone          String?
  alternatePhone String?
  landline       String?
  email          String?

  // Messaging and social. Messenger and Viber carry most customer conversation
  // in the Philippines, so they are first-class fields rather than notes.
  messengerId        String?
  facebook           String?
  viber              String?
  whatsapp           String?
  telegram           String?
  instagram          String?
  tiktok             String?
  /**
   * Shopee / Lazada / TikTok Shop buyer handle.
   */
  marketplaceAccount String?

  // Address, in the order a Philippine address is written. `address` holds the
  // house or unit number and street; barangay is required to actually find a
  // place here, which is why it is stored separately rather than buried in a
  // single free-text line.
  address    String?
  barangay   String?
  city       String?
  province   String?
  region     String?
  postalCode String?

  /**
   * Where this customer was first found (PRD 13), which is not the same as
   * `primaryChannel`, where they now order. Someone discovered on TikTok may
   * since have moved to ordering direct, and marketing needs to keep the
   * original answer.
   */
  sourcePlatform String @default("direct")

  primaryChannel    String    @default("direct")
  followUpStatus    String    @default("none")
  lastInteractionAt DateTime?
  nextFollowUpAt    DateTime?
  notes             String?
  companyUuid       String
  insertedAt        DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  salesOrders   SalesOrder[]
  salesInvoices SalesInvoice[]
  deliveryNotes DeliveryNote[]
  interactions  CustomerInteraction[]

  @@index([companyUuid])
  @@index([companyUuid, nextFollowUpAt])
}

model Supplier {
  uuid        String   @id @default(uuid())
  /// Registered business name, shown on purchase orders and invoices.
  name        String
  address     String?
  /// Tax identification number, printed on supplier invoices.
  tin         String?

  // Point of contact at the supplier. contactName is derived from the parts so
  // lists can show one string that never disagrees with them.
  contactFirstName String?
  contactLastName  String?
  contactPosition  String?
  contactName      String?

  phone       String?
  landline    String?
  email       String?
  notes       String?
  companyUuid String
  insertedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  receiptNotes     ReceiptNote[]
  suppliedItems    Item[]

  @@index([companyUuid])
}

model Process {
  uuid        String   @id @default(uuid())
  name        String
  code        String?
  description String?
  companyUuid String
  insertedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bomProcesses BomProcess[]

  @@index([companyUuid])
}

model Workstation {
  uuid        String   @id @default(uuid())
  name        String
  adminUuid   String?
  companyUuid String
  insertedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members Staff[] @relation("WorkstationMembers")

  @@index([companyUuid])
}

model PaymentMethod {
  uuid        String   @id @default(uuid())
  name        String
  companyUuid String
  insertedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  paymentEntries PaymentEntry[]

  @@index([companyUuid])
}

model Bom {
  uuid        String   @id @default(uuid())
  name        String
  itemUuid    String
  companyUuid String
  insertedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item         Item         @relation(fields: [itemUuid], references: [uuid])
  bomItems     BomItem[]
  bomProcesses BomProcess[]
  workOrders   WorkOrder[]

  @@index([companyUuid])
}

model BomItem {
  uuid         String  @id @default(uuid())
  bomUuid      String
  itemUuid     String
  stockUomUuid String?
  qty          Decimal @default(1) @db.Decimal(18, 4)

  bom      Bom       @relation(fields: [bomUuid], references: [uuid], onDelete: Cascade)
  item     Item      @relation(fields: [itemUuid], references: [uuid])
  stockUom StockUom? @relation(fields: [stockUomUuid], references: [uuid])

  @@index([bomUuid])
}

model BomProcess {
  uuid         String  @id @default(uuid())
  bomUuid      String
  processUuid  String
  position     Int     @default(0)
  toolRequired String?

  bom     Bom     @relation(fields: [bomUuid], references: [uuid], onDelete: Cascade)
  process Process @relation(fields: [processUuid], references: [uuid])

  @@index([bomUuid])
}

model SalesOrder {
  uuid             String    @id @default(uuid())
  code             String
  status           String    @default("to_deliver_and_bill")
  billingStatus    String    @default("not_billed")
  deliveryStatus   String    @default("not_delivered")
  productionStatus String    @default("not_started")
  channel          String    @default("direct")
  externalRef      String?
  fulfillmentModel String    @default("make_to_order")
  priority         Int       @default(0)
  requiredDate     DateTime?
  notes            String?
  customerUuid     String
  customerName     String
  customerAddress  String?
  warehouseUuid    String
  totalAmount      Decimal   @default(0) @db.Decimal(18, 4)
  paidAmount       Decimal   @default(0) @db.Decimal(18, 4)
  totalQty         Decimal   @default(0) @db.Decimal(18, 4)
  deliveredQty     Decimal   @default(0) @db.Decimal(18, 4)
  companyUuid      String
  insertedAt       DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer      Customer         @relation(fields: [customerUuid], references: [uuid])
  warehouse     Warehouse        @relation(fields: [warehouseUuid], references: [uuid])
  items         SalesOrderItem[]
  deliveryNotes DeliveryNote[]
  salesInvoices SalesInvoice[]
  workOrders    WorkOrder[]

  @@index([companyUuid])
  @@index([companyUuid, channel])
}

model SalesOrderItem {
  uuid           String   @id @default(uuid())
  salesOrderUuid String
  itemUuid       String
  itemName       String
  uomName        String?
  stockUomUuid   String?
  unitPrice      Decimal  @default(0) @db.Decimal(18, 4)
  orderedQty     Decimal  @default(0) @db.Decimal(18, 4)
  deliveredQty   Decimal  @default(0) @db.Decimal(18, 4)
  customSpec     String?
  notes          String?
  insertedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salesOrder        SalesOrder         @relation(fields: [salesOrderUuid], references: [uuid], onDelete: Cascade)
  item              Item               @relation(fields: [itemUuid], references: [uuid])
  deliveryNoteItems DeliveryNoteItem[]
  invoiceItems      SalesInvoiceItem[]

  @@index([salesOrderUuid])
}

model DeliveryNote {
  uuid           String   @id @default(uuid())
  code           String
  status         String   @default("to_deliver")
  customerUuid   String
  customerName   String
  salesOrderUuid String
  warehouseUuid  String
  totalAmount    Decimal  @default(0) @db.Decimal(18, 4)
  totalQty       Decimal  @default(0) @db.Decimal(18, 4)
  companyUuid    String
  insertedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer   Customer           @relation(fields: [customerUuid], references: [uuid])
  salesOrder SalesOrder         @relation(fields: [salesOrderUuid], references: [uuid], onDelete: Cascade)
  warehouse  Warehouse          @relation(fields: [warehouseUuid], references: [uuid])
  items      DeliveryNoteItem[]

  @@index([companyUuid])
}

model DeliveryNoteItem {
  uuid               String   @id @default(uuid())
  deliveryNoteUuid   String
  salesOrderItemUuid String
  itemUuid           String
  itemName           String
  uomName            String?
  stockUomUuid       String?
  actualQty          Decimal  @default(0) @db.Decimal(18, 4)
  unitPrice          Decimal  @default(0) @db.Decimal(18, 4)
  insertedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  deliveryNote   DeliveryNote   @relation(fields: [deliveryNoteUuid], references: [uuid], onDelete: Cascade)
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemUuid], references: [uuid])
  item           Item           @relation(fields: [itemUuid], references: [uuid])

  @@index([deliveryNoteUuid])
}

model SalesInvoice {
  uuid           String   @id @default(uuid())
  code           String
  status         String   @default("unpaid")
  /// Grand total payable, VAT included.
  amount         Decimal  @default(0) @db.Decimal(18, 4)
  paidAmount     Decimal  @default(0) @db.Decimal(18, 4)
  customerUuid   String
  customerName   String
  salesOrderUuid String
  companyUuid    String
  insertedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoiceDate  DateTime  @default(now())
  dueDate      DateTime?
  /// due_on_receipt, net_7, net_15, net_30, net_60
  paymentTerms String?

  // Billing details as printed, copied at the time of invoicing so a later edit
  // to the customer never rewrites an issued invoice.
  customerAddress   String?
  customerTin       String?
  /// The customer's own PO or reference number.
  customerReference String?

  /// vat_exclusive, vat_inclusive, vat_exempt or zero_rated.
  vatMode        String  @default("vat_exclusive")
  /// Sum of line gross amounts (qty x unit price), before discounts.
  subtotal       Decimal @default(0) @db.Decimal(18, 4)
  discountAmount Decimal @default(0) @db.Decimal(18, 4)
  /// Amount VAT is charged on (net of VAT and discount).
  vatableAmount  Decimal @default(0) @db.Decimal(18, 4)
  vatAmount      Decimal @default(0) @db.Decimal(18, 4)
  notes          String?

  customer   Customer           @relation(fields: [customerUuid], references: [uuid])
  salesOrder SalesOrder         @relation(fields: [salesOrderUuid], references: [uuid], onDelete: Cascade)
  items      SalesInvoiceItem[]

  @@index([companyUuid])
}

model SalesInvoiceItem {
  uuid               String  @id @default(uuid())
  salesInvoiceUuid   String
  salesOrderItemUuid String?
  itemUuid           String
  itemName           String
  description        String?
  uomName            String?
  qty                Decimal @db.Decimal(18, 4)
  unitPrice          Decimal @db.Decimal(18, 4)
  /// Discount on this line, as an amount.
  discount           Decimal @default(0) @db.Decimal(18, 4)
  /// qty x unitPrice - discount.
  lineTotal          Decimal @db.Decimal(18, 4)

  salesInvoice   SalesInvoice    @relation(fields: [salesInvoiceUuid], references: [uuid], onDelete: Cascade)
  salesOrderItem SalesOrderItem? @relation(fields: [salesOrderItemUuid], references: [uuid])

  @@index([salesInvoiceUuid])
  @@index([salesOrderItemUuid])
}

model PurchaseOrder {
  uuid            String   @id @default(uuid())
  code            String
  status          String   @default("to_receive_and_bill")
  receiptStatus   String   @default("not_received")
  billingStatus   String   @default("not_billed")
  supplierUuid    String
  supplierName    String
  supplierAddress String?
  warehouseUuid   String
  totalAmount     Decimal  @default(0) @db.Decimal(18, 4)
  paidAmount      Decimal  @default(0) @db.Decimal(18, 4)
  totalQty        Decimal  @default(0) @db.Decimal(18, 4)
  receivedQty     Decimal  @default(0) @db.Decimal(18, 4)
  companyUuid     String
  insertedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier         Supplier            @relation(fields: [supplierUuid], references: [uuid])
  warehouse        Warehouse           @relation(fields: [warehouseUuid], references: [uuid])
  items            PurchaseOrderItem[]
  receiptNotes     ReceiptNote[]
  purchaseInvoices PurchaseInvoice[]

  @@index([companyUuid])
}

model PurchaseOrderItem {
  uuid              String   @id @default(uuid())
  purchaseOrderUuid String
  itemUuid          String
  itemName          String
  uomName           String?
  stockUomUuid      String?
  unitPrice         Decimal  @default(0) @db.Decimal(18, 4)
  orderedQty        Decimal  @default(0) @db.Decimal(18, 4)
  receivedQty       Decimal  @default(0) @db.Decimal(18, 4)
  insertedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseOrder    PurchaseOrder     @relation(fields: [purchaseOrderUuid], references: [uuid], onDelete: Cascade)
  item             Item              @relation(fields: [itemUuid], references: [uuid])
  receiptNoteItems ReceiptNoteItem[]

  @@index([purchaseOrderUuid])
}

model ReceiptNote {
  uuid              String   @id @default(uuid())
  code              String
  status            String   @default("to_receive")
  supplierUuid      String
  supplierName      String
  purchaseOrderUuid String
  warehouseUuid     String
  totalAmount       Decimal  @default(0) @db.Decimal(18, 4)
  totalQty          Decimal  @default(0) @db.Decimal(18, 4)
  companyUuid       String
  insertedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supplier      Supplier          @relation(fields: [supplierUuid], references: [uuid])
  purchaseOrder PurchaseOrder     @relation(fields: [purchaseOrderUuid], references: [uuid], onDelete: Cascade)
  warehouse     Warehouse         @relation(fields: [warehouseUuid], references: [uuid])
  items         ReceiptNoteItem[]

  @@index([companyUuid])
}

model ReceiptNoteItem {
  uuid                  String   @id @default(uuid())
  receiptNoteUuid       String
  purchaseOrderItemUuid String
  itemUuid              String
  itemName              String
  uomName               String?
  stockUomUuid          String?
  actualQty             Decimal  @default(0) @db.Decimal(18, 4)
  unitPrice             Decimal  @default(0) @db.Decimal(18, 4)
  insertedAt            DateTime @default(now())
  updatedAt             DateTime @updatedAt

  receiptNote       ReceiptNote       @relation(fields: [receiptNoteUuid], references: [uuid], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemUuid], references: [uuid])
  item              Item              @relation(fields: [itemUuid], references: [uuid])

  @@index([receiptNoteUuid])
}

model PurchaseInvoice {
  uuid              String   @id @default(uuid())
  code              String
  status            String   @default("unpaid")
  amount            Decimal  @default(0) @db.Decimal(18, 4)
  paidAmount        Decimal  @default(0) @db.Decimal(18, 4)
  supplierUuid      String
  supplierName      String
  purchaseOrderUuid String
  companyUuid       String
  insertedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supplier      Supplier      @relation(fields: [supplierUuid], references: [uuid])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderUuid], references: [uuid], onDelete: Cascade)

  @@index([companyUuid])
}

model WorkOrder {
  uuid           String    @id @default(uuid())
  code           String
  title          String?
  type           String    @default("production")
  status         String    @default("draft")
  startTime      DateTime?
  endTime        DateTime?
  plannedQty     Decimal   @default(0) @db.Decimal(18, 4)
  storedQty      Decimal   @default(0) @db.Decimal(18, 4)
  producedQty    Decimal   @default(0) @db.Decimal(18, 4)
  scrapedQty     Decimal   @default(0) @db.Decimal(18, 4)
  priority       Int       @default(0)
  dueDate        DateTime?
  itemUuid       String
  itemName       String
  uomName        String?
  stockUomUuid   String?
  bomUuid        String?
  supplierUuid   String?
  supplierName   String?
  salesOrderUuid String?
  warehouseUuid  String
  companyUuid    String
  insertedAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  item             Item                       @relation(fields: [itemUuid], references: [uuid])
  bom              Bom?                       @relation(fields: [bomUuid], references: [uuid])
  warehouse        Warehouse                  @relation(fields: [warehouseUuid], references: [uuid])
  salesOrder       SalesOrder?                @relation(fields: [salesOrderUuid], references: [uuid])
  items            WorkOrderItem[]
  materialRequests WorkOrderMaterialRequest[]
  jobCards         JobCard[]

  @@index([companyUuid])
  @@index([companyUuid, status, priority])
}

model WorkOrderItem {
  uuid          String   @id @default(uuid())
  workOrderUuid String
  itemName      String
  processName   String
  position      Int      @default(0)
  requiredQty   Decimal  @default(0) @db.Decimal(18, 4)
  defectiveQty  Decimal  @default(0) @db.Decimal(18, 4)
  producedQty   Decimal  @default(0) @db.Decimal(18, 4)
  insertedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderUuid], references: [uuid], onDelete: Cascade)
  jobCards  JobCard[]

  @@index([workOrderUuid])
}

model WorkOrderMaterialRequest {
  uuid          String   @id @default(uuid())
  workOrderUuid String
  itemUuid      String
  itemName      String
  uomName       String?
  stockUomUuid  String?
  bomUuid       String?
  warehouseUuid String
  actualQty     Decimal  @default(0) @db.Decimal(18, 4)
  receivedQty   Decimal  @default(0) @db.Decimal(18, 4)
  insertedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderUuid], references: [uuid], onDelete: Cascade)
  item      Item      @relation(fields: [itemUuid], references: [uuid])
  warehouse Warehouse @relation(fields: [warehouseUuid], references: [uuid])
  stockUom  StockUom? @relation(fields: [stockUomUuid], references: [uuid])

  @@index([workOrderUuid])
}

model JobCard {
  uuid                String    @id @default(uuid())
  workOrderUuid       String
  workOrderItemUuid   String
  operatorStaffUuid   String?
  status              String    @default("pending")
  priority            Int       @default(0)
  dueDate             DateTime?
  difficulty          String    @default("standard")
  targetQty           Decimal   @default(0) @db.Decimal(18, 4)
  assignedByUserUuid  String?
  assignedAt          DateTime?
  acceptedAt          DateTime?
  startTime           DateTime?
  pausedAt            DateTime?
  pausedSeconds       Int       @default(0)
  endTime             DateTime?
  producedQty         Decimal   @default(0) @db.Decimal(18, 4)
  defectiveQty        Decimal   @default(0) @db.Decimal(18, 4)
  rejectedQty         Decimal   @default(0) @db.Decimal(18, 4)
  rejectReason        String?
  notes               String?
  validatedByUserUuid String?
  validatedAt         DateTime?
  companyUuid         String
  insertedAt          DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workOrder     WorkOrder     @relation(fields: [workOrderUuid], references: [uuid], onDelete: Cascade)
  workOrderItem WorkOrderItem @relation(fields: [workOrderItemUuid], references: [uuid], onDelete: Cascade)
  operatorStaff Staff?        @relation(fields: [operatorStaffUuid], references: [uuid])
  assignedBy    User?         @relation("JobCardAssignedBy", fields: [assignedByUserUuid], references: [uuid])
  validatedBy   User?         @relation("JobCardValidatedBy", fields: [validatedByUserUuid], references: [uuid])

  @@index([workOrderItemUuid])
  @@index([companyUuid, status])
  @@index([companyUuid, operatorStaffUuid, status])
}

model PaymentEntry {
  uuid               String   @id @default(uuid())
  code               String
  type               String
  partyType          String
  partyUuid          String
  partyName          String
  paymentMethodUuid  String
  totalAmount        Decimal  @default(0) @db.Decimal(18, 4)
  memo               String?
  attachments        String[]
  salesInvoiceIds    String[]
  purchaseInvoiceIds String[]
  companyUuid        String
  insertedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  paymentMethod PaymentMethod @relation(fields: [paymentMethodUuid], references: [uuid])

  @@index([companyUuid])
}

model Counter {
  companyUuid String
  name        String
  value       Int    @default(0)

  @@id([companyUuid, name])
}

// ---------------------------------------------------------------------------
// Accountability, CRM, finance and HR.
//
// These models back the PRD sections that the operational core did not already
// cover. They are tenant-scoped the same way the rest of the schema is: every
// row carries `companyUuid`, and resolvers reach them through requireCompany().
// ---------------------------------------------------------------------------

/**
 * Immutable record of who changed what (PRD 21, BR-01).
 * Written alongside the mutation inside the same transaction, so an audited
 * change cannot commit without its trail. `previousValue` / `newValue` hold the
 * changed fields only, not whole rows — a full snapshot of every document would
 * dwarf the operational tables within a year.
 */
model AuditLog {
  uuid          String   @id @default(uuid())
  action        String
  entityType    String
  entityUuid    String
  previousValue Json?
  newValue      Json?
  summary       String?
  userUuid      String?
  userEmail     String?
  ipAddress     String?
  companyUuid   String
  insertedAt    DateTime @default(now())

  user User? @relation(fields: [userUuid], references: [uuid])

  @@index([companyUuid, insertedAt])
  @@index([companyUuid, entityType, entityUuid])
}

/**
 * In-app notification feed (PRD 19). Channel is recorded so the same row can later fan out to email or Messenger.
 */
model Notification {
  uuid        String    @id @default(uuid())
  type        String
  title       String
  body        String?
  severity    String    @default("info")
  channel     String    @default("in_app")
  entityType  String?
  entityUuid  String?
  userUuid    String?
  role        String?
  readAt      DateTime?
  companyUuid String
  insertedAt  DateTime  @default(now())

  user User? @relation(fields: [userUuid], references: [uuid])

  @@index([companyUuid, userUuid, readAt])
  @@index([companyUuid, type])
}

/**
 * Every touch with a customer, whatever the channel (PRD 13, 14).
 */
model CustomerInteraction {
  uuid         String   @id @default(uuid())
  customerUuid String
  channel      String   @default("messenger")
  direction    String   @default("inbound")
  subject      String?
  body         String?
  outcome      String?
  occurredAt   DateTime @default(now())
  userUuid     String?
  companyUuid  String
  insertedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerUuid], references: [uuid], onDelete: Cascade)
  user     User?    @relation(fields: [userUuid], references: [uuid])

  @@index([customerUuid, occurredAt])
  @@index([companyUuid])
}

/**
 * Configurable follow-up timing (BR-09).
 * The three-day no-response interval from discovery is a seed value, not a
 * constant — `noResponseHours` is what the follow-up job reads.
 */
model FollowUpRule {
  uuid            String   @id @default(uuid())
  name            String
  channel         String   @default("messenger")
  trigger         String   @default("no_response")
  noResponseHours Int      @default(72)
  messageTemplate String?
  isActive        Boolean  @default(true)
  companyUuid     String
  insertedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyUuid])
}

/**
 * Expense categories the owner reports against (PRD 15).
 */
model ExpenseCategory {
  uuid        String   @id @default(uuid())
  name        String
  kind        String   @default("operating")
  companyUuid String
  insertedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses Expense[]

  @@unique([companyUuid, name])
  @@index([companyUuid])
}

model Expense {
  uuid               String   @id @default(uuid())
  code               String
  categoryUuid       String
  description        String?
  amount             Decimal  @default(0) @db.Decimal(18, 4)
  incurredAt         DateTime @default(now())
  paymentMethodUuid  String?
  supplierUuid       String?
  attachments        String[]
  recordedByUserUuid String?
  companyUuid        String
  insertedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category ExpenseCategory @relation(fields: [categoryUuid], references: [uuid])

  @@index([companyUuid, incurredAt])
}

/**
 * Attendance (PRD 17). `source` distinguishes manual entry from an imported timecard feed.
 */
model AttendanceRecord {
  uuid          String    @id @default(uuid())
  staffUuid     String
  workDate      DateTime  @db.Date
  timeIn        DateTime?
  timeOut       DateTime?
  shift         String?
  status        String    @default("present")
  regularHours  Decimal   @default(0) @db.Decimal(10, 2)
  overtimeHours Decimal   @default(0) @db.Decimal(10, 2)
  source        String    @default("manual")
  notes         String?
  companyUuid   String
  insertedAt    DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  staff Staff @relation(fields: [staffUuid], references: [uuid], onDelete: Cascade)

  @@unique([staffUuid, workDate])
  @@index([companyUuid, workDate])
}

/**
 * Payroll run (PRD 16). Statutory lines stay nullable until SSS/PhilHealth rules are confirmed.
 */
model PayrollPeriod {
  uuid        String    @id @default(uuid())
  name        String
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  payDate     DateTime? @db.Date
  status      String    @default("draft")
  companyUuid String
  insertedAt  DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entries PayrollEntry[]

  @@index([companyUuid, startDate])
}

model PayrollEntry {
  uuid                String   @id @default(uuid())
  payrollPeriodUuid   String
  staffUuid           String
  regularHours        Decimal  @default(0) @db.Decimal(10, 2)
  overtimeHours       Decimal  @default(0) @db.Decimal(10, 2)
  basePay             Decimal  @default(0) @db.Decimal(18, 4)
  overtimePay         Decimal  @default(0) @db.Decimal(18, 4)
  incentivePay        Decimal  @default(0) @db.Decimal(18, 4)
  sssDeduction        Decimal  @default(0) @db.Decimal(18, 4)
  philhealthDeduction Decimal  @default(0) @db.Decimal(18, 4)
  otherDeductions     Decimal  @default(0) @db.Decimal(18, 4)
  netPay              Decimal  @default(0) @db.Decimal(18, 4)
  companyUuid         String
  insertedAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt

  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodUuid], references: [uuid], onDelete: Cascade)
  staff         Staff         @relation(fields: [staffUuid], references: [uuid])

  @@unique([payrollPeriodUuid, staffUuid])
  @@index([companyUuid])
}

/**
 * Per-company operational settings (BR-09, PRD 10).
 * The production queue model — manager-assigned or floating — is still an open
 * requirement, so it is a setting rather than a hardcoded workflow: the client
 * can switch it without a migration once they decide.
 */
model AppSetting {
  companyUuid String
  key         String
  value       Json
  updatedAt   DateTime @updatedAt

  @@id([companyUuid, key])
}
